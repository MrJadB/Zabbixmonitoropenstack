[Unit]
Description=OpenStack API probe for Zabbix, project scope (slow tier, every 30min)

[Timer]
# 30s after the cloud-scope timer of the same tier, so both do not start together
OnCalendar=*:12/30:30
AccuracySec=1s
RandomizedDelaySec=15s
Unit=os-probe-project@slow.service

[Install]
WantedBy=timers.target
